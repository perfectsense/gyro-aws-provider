project: "gyro-sandbox"
account: "psd-beam-sandbox"
environment: "sandbox"
primary-region: us-east-2
recovery-region: us-east-2
#cluster-name: brightspot-cloud-k1
cluster-domain: 'k1.cloud.brightspot.dev'
